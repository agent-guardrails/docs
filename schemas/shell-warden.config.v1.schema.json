{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.config.v1.schema.json",
  "title": "shell-warden checker configuration v1 (flat rules grammar, ADR-0016)",
  "type": "object",
  "required": ["version", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["ask"], "default": "ask" },
        "message": { "type": "string", "maxLength": 512, "default": "no rule matched — ask the human" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configBytes": { "type": "integer", "maximum": 262144, "default": 262144 },
        "stages": { "type": "integer", "minimum": 1, "maximum": 64, "default": 64 },
        "rules": { "type": "integer", "minimum": 1, "maximum": 512, "default": 512 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/stage" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "required": ["id", "scope", "flags", "rules"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "scope": { "$ref": "#/definitions/conditionGroup" },
        "flags": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "conditionGroup": {
      "type": "object",
      "required": ["anyOf"],
      "additionalProperties": false,
      "properties": {
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "oneOf": [
              { "required": ["argv"], "additionalProperties": false, "properties": { "argv": { "$ref": "#/definitions/argvSequence" } } },
              { "required": ["pattern"], "additionalProperties": false, "properties": { "pattern": { "type": "string", "minLength": 1, "maxLength": 512 } } }
            ]
          }
        }
      }
    },
    "argvSequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["anyOf"],
            "additionalProperties": false,
            "properties": {
              "anyOf": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9/.-]{0,63}$" },
        "action": { "enum": ["allow", "ask", "deny"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "argv": { "$ref": "#/definitions/argvSequence" },
        "argvAt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["at", "one"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "integer", "minimum": 0 },
              "one": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "object",
                    "required": ["anyOf"],
                    "additionalProperties": false,
                    "properties": {
                      "anyOf": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
                    }
                  }
                ]
              }
            }
          }
        },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
        "classification": { "enum": ["static", "opaque"] },
        "flag": {
          "type": "object",
          "additionalProperties": { "enum": ["present", "absent"] }
        },
        "flagValue": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "within": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
            "notWithin": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "allow" } } },
          "then": { "not": { "required": ["message", "pattern", "classification"] }, "$comment": "allow never matches on raw/partial evidence; message is meaningless. Enforced by validation in addition to runtime rules (06 §6.6)." } }
      ]
    }
  }
}
