{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.config.v1.schema.json",
  "title": "shell-warden engine configuration v1.1 (tool-first stages)",
  "type": "object",
  "required": ["version", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["ask"], "default": "ask" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": { "type": "integer", "minimum": 1, "maximum": 64, "default": 64 },
        "configBytes": { "type": "integer", "maximum": 262144 },
        "factsBytes": { "type": "integer", "default": 16384 },
        "factsDepth": { "type": "integer", "default": 8 },
        "maxConcurrentTools": { "type": "integer", "default": 16 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/stage" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "required": ["id", "type", "tool"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "type": { "const": "tool" },
        "tool": { "$ref": "#/definitions/tool" },
        "onExistingDeny": { "enum": ["append", "skip", "replace"], "default": "append" },
        "applyWhen": { "enum": ["always", "ask-only"], "default": "always" },
        "exclusive": { "type": "boolean", "default": false },
        "passive": { "type": "boolean", "default": false },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRejections": { "type": "integer", "minimum": 1, "maximum": 10 },
            "windowMs": { "type": "integer", "minimum": 60000 }
          }
        },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "tool": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "lifecycle": { "enum": ["persistent", "spawn"], "default": "persistent" },
        "idleTimeoutMs": { "type": "integer", "minimum": 30000 },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "boolean" },
                "agent": { "type": "boolean" }
              }
            },
            "mcp": { "type": "boolean" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000, "default": 5000 },
        "killGraceMs": { "type": "integer", "minimum": 50, "maximum": 2000, "default": 250 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 65536 },
        "onError": { "enum": ["skip", "ask", "deny"], "default": "ask" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
