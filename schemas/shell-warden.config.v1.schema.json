{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.config.v1.schema.json",
  "title": "shell-warden engine configuration v1",
  "type": "object",
  "required": ["version", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["ask", "deny"], "default": "ask" },
        "onError": { "enum": ["ask", "deny"], "default": "ask" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkBudgetMs": { "type": "integer", "minimum": 1, "maximum": 30000, "default": 4000 },
        "factsBytes": { "type": "integer", "minimum": 1024, "maximum": 65536, "default": 16384 },
        "factsDepth": { "type": "integer", "minimum": 1, "maximum": 16, "default": 8 },
        "maxAuditPerMinute": { "type": "integer", "minimum": 1, "default": 600 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": { "type": "boolean", "default": false },
        "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "maxItems": 32 },
        "time": { "type": "boolean", "default": false }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/stage" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "required": ["id", "scope", "rules"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "description": { "type": "string", "maxLength": 256 },
        "scope": { "$ref": "#/definitions/scope" },
        "flags": {
          "type": "object",
          "propertyNames": { "pattern": "^-{1,2}[A-Za-z][A-Za-z0-9-]*$" },
          "additionalProperties": { "enum": [0, 1] }
        },
        "terminal": { "type": "boolean", "default": true },
        "exclusive": { "type": "boolean", "default": false },
        "passive": { "type": "boolean", "default": false },
        "rules": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["anyOf"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "array", "items": { "type": "string" }, "default": ["shell"] },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "argv": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string" } },
              "pattern": { "type": "string", "maxLength": 512 }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "when": { "$ref": "#/definitions/when" },
        "action": { "enum": ["allow", "ask", "deny"] },
        "message": { "type": "string", "maxLength": 512 },
        "cacheTtlMs": { "type": "integer", "minimum": 0, "maximum": 3600000, "default": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "allow" }, "cacheTtlMs": { "type": "integer", "minimum": 1 } },
            "required": ["action", "cacheTtlMs"]
          },
          "then": {
            "properties": { "when": { "not": { "anyOf": [ { "required": ["git"] }, { "required": ["env"] }, { "required": ["time"] } ] } } }
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } },
        "argvAt": {
          "type": "object",
          "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
          "additionalProperties": { "type": "string" }
        },
        "pattern": { "type": "string", "maxLength": 512 },
        "classification": { "enum": ["static", "opaque"] },
        "flag": {
          "type": "object",
          "propertyNames": { "pattern": "^-{1,2}[A-Za-z][A-Za-z0-9-]*$" },
          "additionalProperties": { "enum": ["present", "absent"] }
        },
        "flagValue": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^-{1,2}[A-Za-z][A-Za-z0-9-]*$" },
          "additionalProperties": { "type": "string", "maxLength": 256 }
        },
        "paths": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["within"],
            "additionalProperties": false,
            "properties": {
              "operandIndex": { "type": "integer", "minimum": 0 },
              "within": { "enum": ["cwd", "project", "home", "any"] },
              "glob": { "type": "string", "maxLength": 512 }
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": { "$ref": "#/definitions/stringMatcher" },
            "upstream": { "$ref": "#/definitions/stringMatcher" },
            "dirty": { "type": "boolean" }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "cron": { "type": "string", "maxLength": 128 } }
        }
      }
    },
    "stringMatcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "glob": { "type": "string", "maxLength": 256 },
        "equals": { "type": "string" }
      }
    }
  }
}
