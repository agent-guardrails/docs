{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/pr-review-bundle.v1.schema.json",
  "title": "Auditable PR review bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectorVersion", "repository", "pullRequest", "baseSha", "headSha", "collectedAt", "localWorktree", "selectedCi", "artifacts", "incompleteOrUnavailableEvidence", "fileHashesSha256", "manifestCanonicalSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collectorVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository": { "$ref": "#/$defs/repository" },
    "pullRequest": { "$ref": "#/$defs/pullRequest" },
    "baseSha": { "$ref": "#/$defs/gitSha" },
    "headSha": { "$ref": "#/$defs/gitSha" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "localWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "verifiedHeadSha"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/(?!.*[\\u0000-\\u001F\\u007F]).+$" },
        "verifiedHeadSha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "selectedCi": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectedCi" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "incompleteOrUnavailableEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/unavailableEvidence" }
    },
    "fileHashesSha256": { "$ref": "#/$defs/sha256" },
    "manifestCanonicalSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,128}$"
    },
    "safeArtifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "url"],
      "properties": {
        "owner": { "const": "agent-guardrails" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "minLength": 1, "maxLength": 100 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/agent-guardrails/[A-Za-z0-9_.-]+$" }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/agent-guardrails/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$" }
      }
    },
    "selectedCi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "url", "state", "evidenceState"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1, "maxLength": 256 },
        "jobId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1, "maxLength": 256 },
        "url": { "type": "string", "format": "uri" },
        "logUrl": { "type": "string", "format": "uri" },
        "state": { "enum": ["queued", "in_progress", "completed", "unknown"] },
        "conclusion": { "enum": ["success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required", "startup_failure", "stale", "unknown"] },
        "evidenceState": { "enum": ["available", "unavailable", "missing", "failed", "pending", "cancelled", "skipped", "inaccessible"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safeArtifactPath" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "unavailableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "reason"],
      "properties": {
        "kind": { "enum": ["check", "ci-run", "ci-job", "ci-log", "remote-evidence"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  },
  "$comment": "Cross-file equality, uniqueness, inventory completeness, canonical hashing, and path containment require bundle-level validation defined by spec/pr-review/README.md."
}
