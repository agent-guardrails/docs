{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.letter.v1.schema.json",
  "title": "shell-warden letter v1 (one-shot request, 02-letter-verdict.md §2.2)",
  "type": "object",
  "required": ["version", "invocation", "action", "commands"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "invocation": {
      "type": "object",
      "required": ["id", "sessionID"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sessionID": { "type": "string", "minLength": 1, "maxLength": 256 },
        "agent": { "type": "string", "maxLength": 256 },
        "projectDir": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "action": { "type": "string", "minLength": 1, "maxLength": 64, "enum": ["shell"], "$comment": "v1 scope: shell only (ADR-0016 N5)." },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["index", "raw", "cwd"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "raw": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  },
  "$comment": "No harness-supplied argv split, no context metadata: the checker parses raw itself and performs no context lookups in v1 (07 §7.1; ADR-0016). Sizes: letter ≤ 64 KiB, ≤ budgets.maxRequestCommands commands (hook-enforced, I4)."
}
