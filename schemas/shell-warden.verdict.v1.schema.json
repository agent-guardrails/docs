{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.verdict.v1.schema.json",
  "title": "shell-warden verdict v1 (one-shot response, 02-letter-verdict.md §2.3)",
  "type": "object",
  "required": ["invocationId", "verdict", "commands"],
  "additionalProperties": false,
  "properties": {
    "invocationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "verdict": { "enum": ["allow", "ask", "deny"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["index", "verdict", "classification", "match"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "verdict": { "enum": ["allow", "ask", "deny"] },
          "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9/.-]{0,63}$" },
          "classification": { "enum": ["static", "opaque"] },
          "match": { "enum": ["argv", "raw"], "$comment": "argv = fully parsed token match (the only kind an allow may carry); raw = raw-glob match (deny/ask only, 06 §6.6 / 08 §8.2)." },
          "facts": { "type": "object", "$comment": "≤ 16 KiB serialized, depth ≤ 8 (I6); no secrets." }
        },
        "allOf": [
          { "if": { "properties": { "verdict": { "const": "deny" } } },
            "then": { "required": ["ruleId"] } },
          { "if": { "properties": { "match": { "const": "raw" } } },
            "then": { "properties": { "verdict": { "enum": ["ask", "deny"] } } } }
        ]
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "verdict": { "const": "deny" } } },
      "then": { "required": ["message"] } }
  ],
  "$comment": "Aggregate message required on deny (02 §2.3); verdict output ≤ 64 KiB."
}
