# shell-warden config v2 structural grammar snapshot
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct ArgumentsMatcher { #[serde ( default )] pub exact : Option < Vec < String > > , #[serde ( default )] pub prefix : Option < Vec < String > > , pub remainder : Option < RemainderPolicy > , #[serde ( default )] pub contains_any : Option < Vec < String > > , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct EnvironmentTest { pub name : String , #[serde ( default )] pub value : Option < StringValueSelector > , #[serde ( default )] pub prefix : Option < bool > , #[serde ( default )] pub occurrence : Option < Occurrence > , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct FactTest { #[serde ( default )] pub analyzer : Option < String > , #[serde ( default )] pub version : Option < String > , pub name : String , #[serde ( default )] pub occurrence : Option < Occurrence > , #[serde ( default )] pub value : Option < TypedValueSelector > , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct NestedPartTest { #[serde ( default , deserialize_with = "present_not_null" , skip_serializing_if = "Option::is_none" )] pub relation : Option < Relation > , #[serde ( default , deserialize_with = "present_not_null" , skip_serializing_if = "Option::is_none" )] pub profile : Option < String > , #[serde ( default , deserialize_with = "present_not_null" , skip_serializing_if = "Option::is_none" )] pub classification : Option < EvidenceClass > , #[serde ( default , deserialize_with = "present_not_null" , skip_serializing_if = "Option::is_none" )] pub verdict : Option < VerdictKind > , #[serde ( default , deserialize_with = "present_not_null" , skip_serializing_if = "Option::is_none" )] pub occurrence : Option < Occurrence > , }
pub struct OptionCoverage { pub option : String , pub required : bool , pub repeatable : bool , }
pub enum OptionCoverageEntry { ZeroArity ( OptionCoverage ) , PositiveArity ( PositiveArityOptionCoverage ) , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct OptionSpec { pub aliases : Vec < String > , pub arity : u8 , #[serde ( default )] pub inline : Option < bool > , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub enum OptionValueCoverage { Each { each : TokenSelector } , ByPosition { by_position : Vec < TokenSelector > } , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct OptionsMatcher { #[serde ( default )] pub present_all : Option < Vec < String > > , #[serde ( default )] pub present_any : Option < Vec < String > > , #[serde ( default )] pub absent_all : Option < Vec < String > > , pub values : Option < std :: collections :: BTreeMap < String , TokenSelector > > , pub none : Option < bool > , pub allowed : Option < Vec < OptionCoverageEntry > > , }
#[serde ( deny_unknown_fields )] #[serde ( untagged )] pub enum PathCoverage { None { none : bool } , All { all : Vec < PathEntry > } , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] #[serde ( untagged )] pub enum PathSelector { Exact { exact : String } , Within { within : String } , Outside { outside : String } , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct PositionalCoordinate { pub index : u32 , #[serde ( default )] pub remainder : bool , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub struct PositiveArityOptionCoverage { pub option : String , pub required : bool , pub repeatable : bool , pub values : OptionValueCoverage , }
#[serde ( deny_unknown_fields )] #[serde ( untagged )] pub enum RedirectCoverage { None { none : bool } , All { all : Vec < RedirectEntry > } , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub enum RemainderPolicy { None { none : bool } , Each { each : TokenSelector } , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub enum StringValueSelector { Any , OneOf ( Vec < String > ) , Regex ( String ) , }
#[serde ( deny_unknown_fields , rename_all = "camelCase" )] pub enum TokenSelector { Str ( StringValueSelector ) , Path ( PathSelector ) , }
