{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/agent-guardrails/docs/main/schemas/shell-warden.verdict.v2.schema.json",
  "title": "Shell Warden verdict v2",
  "type": "object",
  "required": ["protocol", "result"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "shell-warden.verdict.v2" },
    "result": { "$ref": "#/definitions/Result" }
  },
  "definitions": {
    "RuleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "ProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "Reason": {
      "enum": [
        "complete",
        "opaque-expansion",
        "unknown-option",
        "option-value-missing",
        "invalid-inline-option",
        "unsupported-syntax",
        "empty-command",
        "evidence-limit",
        "allow-evidence-not-complete",
        "allow-coverage-missing",
        "required-option-missing",
        "option-not-repeatable",
        "option-not-allowed",
        "option-value-uncovered",
        "option-value-position-uncovered",
        "remainder-uncovered",
        "redirect-policy-uncovered"
      ]
    },
    "CoverageReason": {
      "enum": [
        "allow-evidence-not-complete",
        "allow-coverage-missing",
        "required-option-missing",
        "option-not-repeatable",
        "option-not-allowed",
        "option-value-uncovered",
        "option-value-position-uncovered",
        "remainder-uncovered",
        "redirect-policy-uncovered"
      ]
    },
    "Reasons": {
      "type": "array",
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/Reason" }
    },
    "RejectedAllow": {
      "type": "object",
      "required": ["ruleId", "reasons"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "$ref": "#/definitions/RuleId" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/CoverageReason" }
        }
      }
    },
    "FullDiagnostics": {
      "type": "object",
      "required": [
        "evidence",
        "reasons",
        "selectedProfiles",
        "matched",
        "qualified",
        "rejected",
        "votes"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence": { "enum": ["complete", "opaque", "invalid"] },
        "reasons": { "$ref": "#/definitions/Reasons" },
        "selectedProfiles": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/definitions/ProfileId" }
        },
        "matched": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuleId" }
        },
        "qualified": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RuleId" }
        },
        "rejected": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/RejectedAllow" }
        },
        "votes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^(allow|ask|deny):\\S{1,128}$"
          }
        }
      }
    },
    "TruncatedDiagnostics": {
      "type": "object",
      "required": ["evidence", "reasons", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "evidence": { "enum": ["complete", "opaque", "invalid"] },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Reason" }
        },
        "diagnostics": { "const": "truncated-after-decision" }
      }
    },
    "Diagnostics": {
      "oneOf": [
        { "$ref": "#/definitions/FullDiagnostics" },
        { "$ref": "#/definitions/TruncatedDiagnostics" }
      ],
      "$comment": "Serialized facts are capped at 16 KiB and depth 8 by the runtime."
    },
    "Command": {
      "type": "object",
      "required": ["index", "verdict", "classification", "match"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "verdict": { "enum": ["allow", "ask", "deny"] },
        "ruleId": { "$ref": "#/definitions/RuleId" },
        "classification": { "enum": ["static", "opaque", "invalid"] },
        "match": { "enum": ["argv", "raw"] },
        "facts": { "$ref": "#/definitions/Diagnostics" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "classification": { "const": "static" },
                "match": { "const": "argv" },
                "verdict": { "enum": ["allow", "ask", "deny"] }
              }
            },
            {
              "properties": {
                "classification": { "const": "opaque" },
                "match": { "const": "raw" },
                "verdict": { "enum": ["ask", "deny"] }
              }
            },
            {
              "properties": {
                "classification": { "const": "invalid" },
                "match": { "const": "raw" },
                "verdict": { "enum": ["ask", "deny"] }
              }
            }
          ]
        },
        {
          "if": {
            "required": ["verdict"],
            "properties": { "verdict": { "const": "deny" } }
          },
          "then": { "required": ["ruleId"] }
        },
        {
          "if": {
            "required": ["classification", "facts"],
            "properties": { "classification": { "const": "static" } }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": { "evidence": { "const": "complete" } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification", "facts"],
            "properties": { "classification": { "const": "opaque" } }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": { "evidence": { "const": "opaque" } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification", "facts"],
            "properties": { "classification": { "const": "invalid" } }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": { "evidence": { "const": "invalid" } }
              }
            }
          }
        }
      ]
    },
    "Result": {
      "type": "object",
      "required": ["invocationId", "verdict", "commands"],
      "additionalProperties": false,
      "properties": {
        "invocationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "verdict": { "enum": ["allow", "ask", "deny"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/definitions/Command" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["verdict"],
            "properties": { "verdict": { "const": "deny" } }
          },
          "then": { "required": ["message"] }
        }
      ]
    }
  },
  "$comment": "Aggregate verdict consistency and the 64 KiB total verdict cap are enforced outside draft-07 by the validator and runtime."
}
